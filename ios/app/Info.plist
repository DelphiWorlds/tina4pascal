<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>        <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>              <string>Tina4Pascal</string>
  <key>CFBundleDisplayName</key>       <string>Tina4Pascal</string>
  <key>CFBundleIdentifier</key>        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key>           <string>1</string>
  <key>CFBundlePackageType</key>       <string>APPL</string>
  <key>LSRequiresIPhoneOS</key>        <true/>
  <key>UILaunchScreen</key>            <dict/>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key><false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
          <key>UISceneConfigurationName</key><string>Default Configuration</string>
          <key>UISceneDelegateClassName</key><string>SceneDelegate</string>
        </dict>
      </array>
    </dict>
  </dict>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <!-- the <camera> control uses the camera + saves the shot -->
  <key>NSCameraUsageDescription</key>
  <string>Take a photo to show it in the page.</string>
  <!-- the <recorder> control captures microphone audio -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Record audio for the page.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Use your location while the app is in the foreground.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Allow location access to continue updates while the app is in the background.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
</dict>
</plist>
